{
  "name": "@orthic/waitlist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "dev": "pnpm run build && wrangler dev --local --port 8787",
    "deploy": "pnpm run build:production && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply orthic-waitlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply orthic-waitlist --remote",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wrangler": "^4.36.0"
  }
}
